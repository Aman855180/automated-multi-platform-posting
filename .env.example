# ==============================================================================
# Automated Multi-Platform Posting System - Environment Configuration
# Copy this file to .env and populate with your real platform credentials.
# Any platform with missing credentials will fail gracefully with clear errors.
# ==============================================================================

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=4000
APP_ENV=development
REQUEST_TIMEOUT_SECONDS=10.0

# 1. Mastodon API
# Instance URL (e.g., https://mastodon.social) and OAuth Bearer Access Token
# Scope required: write:statuses
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 2. Bluesky (AT Protocol)
# Your Bluesky handle (e.g. user.bsky.social) and App Password
# Generate App Password in Bluesky -> Settings -> Privacy and Security -> App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# 3. Telegram Bot API
# Bot token created via @BotFather on Telegram
# Target Chat ID or Channel Username (e.g. @your_channel or -1001234567890)
# Channel Username for public web permalink construction (optional, e.g. your_channel without @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_USERNAME=

# 4. Reddit API
# Create a Script App at https://www.reddit.com/prefs/apps
# Subreddit to post to (without r/, e.g. test)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_SUBREDDIT=test
REDDIT_USER_AGENT=automated-posting:v1.0.0 (by /u/your_reddit_username)

# 5. LinkedIn Posts API
# OAuth 2.0 User Access Token with `w_member_social` permission
# Author URN: urn:li:person:<id> or urn:li:organization:<id>
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# 6. WordPress REST API (Optional / Extensible Platform)
# Site URL (e.g. https://example.com) and Application Password created in WordPress Users profile
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# 7. Discord Webhook API
# Create a Webhook: Discord Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_SERVER_ID is optional (used to construct direct web message link https://discord.com/channels/{server_id}/{channel_id}/{msg_id})
DISCORD_WEBHOOK_URL=
DISCORD_SERVER_ID=

# 8. Dev.to (Forem REST API)
# Generate API key at: https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=


